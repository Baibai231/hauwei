# Copy this file to `.env` and fill credentials there.
# `.env` is gitignored: keep THIS example file free of real keys.
# ScholarFlow runs without credentials in deterministic demo mode.
# AI provider: auto | openai | coze | off
# "auto" prefers the NK-GeniOS (Coze) agent when GENIOS_* is set, then falls back to LLM_*.
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=120

# --- Option A: OpenAI-compatible provider (OpenAI / DeepSeek / local vLLM ...) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Option B: NK-GeniOS (Coze) agent ---------------------------------------
# Confirmed on the Nankai publish page (API channel = running, 2026-10-09).
GENIOS_BASE_URL=https://coze.nankai.edu.cn/api/proxy/api/v1
GENIOS_API_KEY=
GENIOS_AGENT_ID=db3qtdd4shhas0al22qg
GENIOS_USER_ID=scholarflow-local
# Chat path appended to GENIOS_BASE_URL. Confirm it on the platform's "接口说明"
# page, or probe it with: .venv\Scripts\python.exe backend\scripts\check_genios.py
GENIOS_CHAT_PATH=/v3/chat
# Name of the query parameter when the platform authenticates that way, e.g. api_key.
GENIOS_API_KEY_PARAM=

# --- Option C: local browser bridge (AI_PROVIDER=genios_browser) -------------
# Reuse a logged-in local browser over CDP when the platform API sits behind SSO.
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_TARGET_HOST=coze.nankai.edu.cn
BROWSER_CHAT_URL=https://coze.nankai.edu.cn/product/llm/chat/db42qo54shhbpg8vnl40
BROWSER_TIMEOUT_SECONDS=240
BROWSER_NEW_CONVERSATION=true

# Shared secret that the Nankai agent must send as `Authorization: Bearer <token>`
# when it calls the local /api/genios/* tools. Leave empty for local-only use.
GENIOS_TOOL_TOKEN=

# Optional polite-pool identifier for OpenAlex.
OPENALEX_EMAIL=

VITE_API_URL=
